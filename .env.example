# Token de BotFather. En local también se lee de secrets/botfather.
TELEGRAM_BOT_TOKEN=123456:ejemplo-falso-de-telegram

# API key de Gemini. En local también se lee de secrets/gemini.
GEMINI_API_KEY=AQ.ejemplo-falso-de-gemini

# URL del proyecto Supabase (Project Settings → API).
SUPABASE_URL=https://tu-proyecto.supabase.co

# Key nueva sb_publishable_… (sustituye al anon JWT). Va al bot y al dashboard.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ejemplo_falso

# Opcional. Si aparece una sb_secret_…, el bot la prefiere.
# SUPABASE_SECRET_KEY=sb_secret_ejemplo_falso

# Las mismas dos, con prefijo VITE_, para el dashboard estático.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ejemplo_falso
